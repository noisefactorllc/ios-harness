#!/usr/bin/env node
'use strict'

/**
 * Standalone native iOS build helper (the "generate" side of native mode).
 *
 *   node bin/ios-native init  [product…]   # scaffold <repo>/mobile/ (reproducible)
 *   node bin/ios-native build [product…]   # cap sync + xcodebuild -> Simulator .app
 *   node bin/ios-native run    <product>    # build, install, launch in the Simulator
 *   node bin/ios-native list                # products with a native build config
 *
 * With no product args, init/build apply to ALL native-capable products.
 * To actually test a build, use `bin/ios-test --native [product…]`.
 */

const products = require('../lib/products')
const native = require('../lib/native')

function nativeKeysOr(keys) {
    if (keys.length) {
        return keys.map((k) => {
            const p = products.BY_KEY.get(k)
            if (!p) throw new Error(`Unknown product "${k}". Known: ${products.allKeys().join(', ')}`)
            if (!p.native) throw new Error(`${k} has no native build config (products.js: native:{appId,appName})`)
            return p
        })
    }
    return products.nativeProducts()
}

function usage() {
    console.log(`Standalone native iOS build helper

Usage:
  node bin/ios-native <command> [product…]

Commands:
  init [product…]    scaffold <repo>/mobile/ (package.json + capacitor.config + ios/)
  build [product…]   sync web assets + xcodebuild an unsigned Simulator .app
  run <product>      build, install, and launch the .app in the Simulator
  list               list products that have a native build config

Native-capable products: ${products.nativeProducts().map((p) => p.key).join(', ')}`)
}

const log = (m) => console.log(m)

async function cmdInit(keys) {
    for (const p of nativeKeysOr(keys)) {
        console.log(`\n▶ init ${p.key}`)
        await native.initProject(p, { log })
        console.log(`  ✓ ${native.mobileDir(p)}`)
    }
}

async function cmdBuild(keys) {
    for (const p of nativeKeysOr(keys)) {
        console.log(`\n▶ build ${p.key}`)
        const built = await native.buildApp(p, { log })
        console.log(`  ✓ ${built.appPath}`)
    }
}

async function cmdRun(keys) {
    if (keys.length !== 1) throw new Error('run takes exactly one product')
    const simulator = require('../lib/simulator')
    const { execFile } = require('node:child_process')
    const [p] = nativeKeysOr(keys)

    await simulator.ensureToolchain()
    const device = await simulator.resolveDevice()
    console.log(`Device: ${device.name} — ${device.deviceTypeName}, ${device.runtimeName}`)
    console.log(`Booting ${device.udid}…`)
    await simulator.boot(device.udid)
    execFile('open', ['-a', 'Simulator']) // bring the Simulator UI up to watch

    const built = await native.buildApp(p, { log })
    console.log(`Installing ${built.appName}.app…`)
    await simulator.installApp(device.udid, built.appPath)
    console.log(`Launching ${built.bundleId}…`)
    const pid = await simulator.launchApp(device.udid, built.bundleId)
    console.log(`  ✓ launched (${pid}). Watch it in the Simulator.`)
}

async function main() {
    const [cmd, ...rest] = process.argv.slice(2)
    const keys = rest.filter((a) => !a.startsWith('-'))
    try {
        switch (cmd) {
            case 'init':
                return await cmdInit(keys)
            case 'build':
                return await cmdBuild(keys)
            case 'run':
                return await cmdRun(keys)
            case 'list':
                for (const p of products.nativeProducts()) console.log(`  ${p.key.padEnd(13)} ${p.native.appId}`)
                return
            case '-h':
            case '--help':
            case undefined:
                return usage()
            default:
                console.error(`Unknown command "${cmd}"`)
                usage()
                process.exit(1)
        }
    } catch (e) {
        console.error(`\n\x1b[31m✗ ${e.message}\x1b[0m`)
        process.exit(1)
    }
}

main()
