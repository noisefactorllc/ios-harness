#!/usr/bin/env node
'use strict'

/**
 * Single pre-commit entrypoint for the iOS Simulator test harness.
 *
 *   node bin/ios-test                 # all 9 products, full suites
 *   node bin/ios-test noisedeck       # one or more products by key
 *   node bin/ios-test --smoke         # shared iOS-risk suite only (fast)
 *   node bin/ios-test --list          # list product keys
 *
 * Exit code is non-zero on any failure (suitable for a pre-commit gate).
 */

const path = require('node:path')
const products = require('../lib/products')

function usage() {
    console.log(`iOS Simulator test harness

Usage:
  node bin/ios-test [product…] [options]

Products: ${products.allKeys().join(', ')}

Options:
  --smoke        run only the shared iOS-risk suite (skip per-product flows)
  --list         list product keys and exit
  -h, --help     show this help

Prerequisite: a working toolchain (run \`npm run bootstrap\` first).`)
}

async function main() {
    const argv = process.argv.slice(2)
    if (argv.includes('-h') || argv.includes('--help')) return usage()
    if (argv.includes('--list')) {
        for (const p of products.PRODUCTS) {
            console.log(`  ${p.key.padEnd(13)} ${p.title}${p.backendGated ? '  (front-end only)' : ''}`)
        }
        return
    }

    const sharedOnly = argv.includes('--smoke')
    const keys = argv.filter((a) => !a.startsWith('-'))

    // Validate keys up front for a clear error.
    try {
        products.resolve(keys.length ? keys : undefined)
    } catch (e) {
        console.error(`\x1b[31m${e.message}\x1b[0m`)
        process.exit(1)
    }

    const { run, formatSummary } = require('../lib/runner')
    let summary
    try {
        summary = await run({ keys: keys.length ? keys : undefined, sharedOnly, log: (m) => console.log(m) })
    } catch (e) {
        console.error(`\n\x1b[31m✗ harness error:\x1b[0m ${e.message}`)
        if (/toolchain|simctl|Xcode/i.test(e.message)) {
            console.error('\nRun `npm run bootstrap` to set up the toolchain.')
        }
        process.exit(1)
    }

    console.log(formatSummary(summary))
    process.exit(summary.ok ? 0 : 1)
}

main()
